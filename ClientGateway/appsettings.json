{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "kafkaConfig": {
    "BootstrapServer": "localhost:9092",
    "CliendId": "kafka-producer-01",
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "PLAIN",
    "SaslUsername": "KafkaUsername",
    "SaslPassword": "KafkaPassword123",
    "EnableIdepomtence": true,
    "MaxInFlight": 5,
    "Retries": 3,
    "Acks": "All"
  },
  "SchemaConfig": {
    "Url": "http://localhost:8081",
    "BasicAuthCredentialsSource": "UserInfo",
    "BasicAuthUserInfo": "username123:password123",
    "MaxCachedSchemas": 1000
  }
}

