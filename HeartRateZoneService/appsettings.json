{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "kafkaConfigConsumer": {
    "BootstrapServer": "localhost:9092",
    "CliendId": "kafka-consumer-01",
    "SecurityProtocol": "SaslSsl",
    "SaslMechanism": "PLAIN",
    "SaslUsername": "KafkaUsername",
    "SaslPassword": "KafkaPassword123",
    "GroupId": "consumer-group-01",
    "AutoOffsetReset": "Earliest", //Earliest - Latest
    "EnalbeAutoCommit": true,
    "AutoCommitIntervalMs": 5000,
    "EnableAutoOffsetStore": false
  },
  "SchemaConfig": {
    "Url": "http://localhost:8081",
    "BasicAuthCredentialsSource": "UserInfo",
    "BasicAuthUserInfo": "username123:password123",
    "MaxCachedSchemas": 1000
  }
}

